# Optional OpenAI-compatible LLM. Empty values mean deterministic rule fallback.
SWITCH_LLM_BASE_URL=
SWITCH_LLM_API_KEY=
SWITCH_LLM_MODEL=
SWITCH_LLM_TIMEOUT_S=8

# Optional Person 2 base URL. Routes in the integration contract are PROPOSED until confirmed by Person 2.
SWITCH_CORE_API_URL=
SWITCH_CORE_API_TOKEN=
SWITCH_CORE_API_TIMEOUT_S=5

# Local simulated adapter only; this is NOT OAuth 2.1 + PKCE for live Alexa+.
SWITCH_MCP_BEARER_TOKEN=
SWITCH_DEMO_HOUSEHOLD_ID=hh_demo
SWITCH_ML_WINDOW_EVENTS=30
