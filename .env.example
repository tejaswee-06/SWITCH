# SWITCH environment example. Copy to .env.local (frontend) / export in your shell (backend). Variable names only:
# there are NO real secrets in this project. Never commit real keys or tokens.

# ---------------- Frontend (Vite; read at dev-server start) ----------------
# Canonical SWITCH backend. If unreachable, the UI falls back to the in-browser simulator and labels results LOCAL.
VITE_SWITCH_API_URL=http://127.0.0.1:8000
# DEMO-ONLY token seeded by the backend in SWITCH_ENV=demo (owner of hh_demo). Public fixture, not a secret.
VITE_SWITCH_DEMO_TOKEN=demo-owner-token
# Set to 1 to force the browser-only offline mode (same as opening the app with ?offline).
# VITE_SWITCH_OFFLINE=1

# ---------------- Backend (switch_backend) ----------------
SWITCH_ENV=demo                     # demo => seeds demo households + DEMO-ONLY tokens, enables /demo/reset
SWITCH_DEMO_PROFILE=journey         # journey (product demo) | regression (original Person 2 fixtures)
SWITCH_DB=data/switch.db            # SQLite path (relative to switch_backend/); created and migrated on start
SWITCH_HOST=127.0.0.1
SWITCH_PORT=8000
# Comma-separated allowed browser origins (default covers localhost/127.0.0.1 on 5173, 4173 and 3000)
# SWITCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SWITCH_CONTRACT_PATH=../contracts/canonical_home.json   # override location of the shared room/device contract

# ---------------- Person 3C (optional) ----------------
# Optional OpenAI-compatible LLM for correction interpretation. Leave EMPTY to use the deterministic rules only
# (the default; no external call is made). Output is schema-validated and cross-checked against the rules.
SWITCH_LLM_BASE_URL=
SWITCH_LLM_API_KEY=
SWITCH_LLM_MODEL=
SWITCH_LLM_TIMEOUT_S=8
SWITCH_ML_WINDOW_EVENTS=30
# SWITCH_ML_ARTIFACT_DIR=           # defaults to switch_backend/switch_p3c/artifacts

# ---------------- Alexa+ ----------------
# Route C (simulated in-app experience) needs no configuration and contacts no Amazon endpoint.
# A live Alexa+ MCP route would need OAuth 2.1 + PKCE client settings and a public HTTPS URL — NOT implemented.
